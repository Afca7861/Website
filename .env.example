# Copy this file to .env and fill in real values before deploying.

# A long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# "production" enables secure (HTTPS-only) cookies and trusts the
# reverse proxy most hosting platforms put in front of the app.
NODE_ENV=production

# Port the server listens on. Most hosting platforms set this for you.
PORT=3000

# The email address of the account that should become an admin (able to
# post/edit/delete listings at /admin.html). Register a normal account on
# the site with this exact email first, then set this variable and
# (re)start the server — it grants the 'admin' role on every startup, so
# it's safe to leave set. See README.md "Admin panel" section.
ADMIN_BOOTSTRAP_EMAIL=

# Only needed on a host with a persistent disk attached (e.g. Render's
# paid plans). Set this to the disk's mount path and the database,
# sessions, and uploaded photos all live there instead of the app's
# ephemeral source tree, so nothing gets wiped on redeploy or restart.
# Leave unset for local development. See README.md "Persistent storage
# on Render".
DATA_DIR=

# Set MAINTENANCE_MODE=true (plus a MAINTENANCE_BYPASS_TOKEN below) to take
# the site offline for the public while you keep testing via a private
# preview link. Leave both unset the rest of the time. See README.md
# "Taking the site offline temporarily".
MAINTENANCE_MODE=
MAINTENANCE_BYPASS_TOKEN=

# Car Parts checkout payments — see README.md "Car Parts checkout &
# payments (PayPal)" for full setup steps. From a PayPal Business
# account's app at developer.paypal.com -> Apps & Credentials.
# Leave PAYPAL_MODE as "sandbox" (fake test money) until you're ready to
# take real payments, then switch to "live". Checkout tells visitors
# "not set up yet" until PAYPAL_CLIENT_ID/SECRET are both filled in.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
